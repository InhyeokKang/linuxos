#!/bin/sh
# Haneul 세션 시작: 배포판 기본 설정 디렉터리를 XDG 검색 경로 맨 앞에 둔 뒤 XFCE 실행
case ":${XDG_CONFIG_DIRS:-}:" in
  *:/etc/xdg/xdg-haneul:*) ;;
  *) XDG_CONFIG_DIRS="/etc/xdg/xdg-haneul:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac
export XDG_CONFIG_DIRS
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=haneul
export DESKTOP_SESSION=haneul

# D-Bus 로 활성화되는 데몬(xfconfd 등)도 같은 환경을 쓰도록 전파
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION 2>/dev/null \
    || dbus-update-activation-environment XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION 2>/dev/null || true
fi
exec startxfce4 "$@"
