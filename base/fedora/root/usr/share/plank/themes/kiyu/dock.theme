TopPadding=2
BottomPadding=3
ItemPadding=2.5
IndicatorSize=4
IconShadowSize=0
UrgentBounceHeight=1.2
LaunchBounceHeight=0.4
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=200
FadeTime=200
HideTime=200
GlowSize=20
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=350
CascadeHide=true
BadgeColor=244;;124;;12;;255
