# kiyu Plank 독 테마 (밝은 모드). 색은 R;;G;;B;;A
[PlankTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=255;;255;;255;;170
FillStartColor=252;;250;;247;;238
FillEndColor=252;;250;;247;;238
InnerStrokeColor=255;;255;;255;;0

[PlankDockTheme]
