#!/usr/bin/python3
"""설치 프로그램이 닫힌 뒤 보여 주는 화면.

설치 매체에는 데스크톱이 없으므로, Anaconda 를 닫으면 갈 곳이 없다. 예전에는
installer-session 이 곧바로 설치 프로그램을 다시 띄워서, 설치를 끝내고 "설치 종료"를
눌러도 설치 화면으로 되돌아갔다. 이 화면이 그 자리를 대신한다.

/tmp/anaconda.log 에 설치 완료 기록이 있으면 재부팅을, 없으면 설치 재시작을 기본으로 둔다.
로그는 0644 로 만들어지므로 liveuser 도 읽을 수 있다. 읽지 못해도 중립 문구로 뜬다.

종료 코드로 installer-session 에 결과를 알린다:
    10 재부팅   11 전원 끄기   12 설치 다시 하기
"""
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

ANACONDA_LOG = "/tmp/anaconda.log"
DONE_MARK = "The installation has finished"

RC_REBOOT, RC_POWEROFF, RC_RETRY = 10, 11, 12

CSS = b"""
#screen { background-color: #f7f3ec; }
#title  { font-size: 22pt; font-weight: 700; color: #2b2b2b; }
#sub    { font-size: 12pt; color: #6b6b6b; }
#screen button { padding: 10px 22px; font-size: 12pt; }
"""


def install_finished():
    """설치가 끝까지 진행됐는지 Anaconda 로그로 확인한다."""
    try:
        with open(ANACONDA_LOG, encoding="utf-8", errors="replace") as f:
            return DONE_MARK in f.read()
    except OSError:
        return None  # 알 수 없음


def main():
    done = install_finished()
    if done:
        title = "설치가 끝났습니다"
        sub = "설치 매체(USB·DVD)를 빼고 재부팅하면 kiyu 로 시작합니다."
        default = RC_REBOOT
    elif done is False:
        title = "설치를 마치지 않았습니다"
        sub = "설치 프로그램을 다시 열거나, 컴퓨터를 끌 수 있습니다."
        default = RC_RETRY
    else:
        title = "설치 프로그램이 닫혔습니다"
        sub = "설치를 마쳤다면 재부팅하고, 아니면 설치를 다시 시작하세요."
        default = RC_RETRY

    win = Gtk.Window(title="kiyu")
    win.set_name("screen")
    win.set_decorated(False)
    win.fullscreen()

    result = {"rc": default}

    def finish(rc):
        result["rc"] = rc
        Gtk.main_quit()

    win.connect("delete-event", lambda *_: finish(default))

    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)

    icon = Gtk.Image.new_from_icon_name("kiyu", Gtk.IconSize.DIALOG)
    icon.set_pixel_size(96)
    box.pack_start(icon, False, False, 0)

    lbl = Gtk.Label(label=title)
    lbl.set_name("title")
    box.pack_start(lbl, False, False, 0)

    lbl = Gtk.Label(label=sub)
    lbl.set_name("sub")
    box.pack_start(lbl, False, False, 0)

    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    row.set_halign(Gtk.Align.CENTER)
    buttons = [("지금 재부팅", RC_REBOOT), ("전원 끄기", RC_POWEROFF), ("설치 다시 하기", RC_RETRY)]
    for label, rc in buttons:
        btn = Gtk.Button(label=label)
        btn.connect("clicked", lambda _b, rc=rc: finish(rc))
        if rc == default:
            btn.set_can_default(True)
            btn.get_style_context().add_class("suggested-action")
        row.pack_start(btn, False, False, 0)
    box.pack_start(row, False, False, 12)

    win.add(box)
    win.show_all()
    for child in row.get_children():
        if child.get_can_default():
            win.set_default(child)
            child.grab_focus()
            break
    Gtk.main()
    return result["rc"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        # 이 화면이 떠도 설치 매체가 멈춰 있으면 안 된다. 설치 완료가 확인되면 재부팅,
        # 아니면 설치를 다시 띄우도록 알린다.
        sys.exit(RC_REBOOT if install_finished() else RC_RETRY)
