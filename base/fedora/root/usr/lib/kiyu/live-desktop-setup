#!/bin/sh
# 라이브 세션에서만: 바탕화면에 "설치" 아이콘을 놓습니다.
[ -d /run/initramfs/live ] || [ -d /run/live/medium ] || exit 0
# livesys(Fedora 라이브 스크립트)가 패널 설정을 Fedora 기본으로 바꿔 두었으면 kiyu 기본값으로 복원
PANEL="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
if [ -f /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml ] && ! grep -q whiskermenu "$PANEL" 2>/dev/null; then
    mkdir -p "$(dirname "$PANEL")"
    cp /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml "$PANEL"
    cp /etc/skel/.config/xfce4/panel/*.rc "$HOME/.config/xfce4/panel/" 2>/dev/null || true
    if command -v xfconf-query >/dev/null 2>&1; then
        # 실행 중인 xfconfd 에 반영: 채널을 통째로 다시 읽게 패널 재시작 전에 속성 제거
        xfconf-query -c xfce4-panel -p /panels -r -R 2>/dev/null || true
        xfconf-query -c xfce4-panel -p /plugins -r -R 2>/dev/null || true
    fi
    (sleep 2; xfce4-panel -r) >/dev/null 2>&1 &
fi
# livesys 가 helpers.rc 에 WebBrowser=firefox 를 써 두므로 kiyu 기본값(탱자)으로 되돌림
if [ -f /etc/xdg/xdg-kiyu/xfce4/helpers.rc ]; then
    mkdir -p "$HOME/.config/xfce4"
    cp /etc/xdg/xdg-kiyu/xfce4/helpers.rc "$HOME/.config/xfce4/helpers.rc"
fi
command -v xdg-user-dir >/dev/null 2>&1 && dest="$(xdg-user-dir DESKTOP)" || dest="$HOME/Desktop"
mkdir -p "$dest"
src=/usr/share/applications/kiyu-install.desktop
if [ -f "$src" ] && [ ! -f "$dest/kiyu-install.desktop" ]; then
    cp "$src" "$dest/kiyu-install.desktop"; chmod +x "$dest/kiyu-install.desktop"
fi
# livesys 가 놓는 Fedora 기본 설치 아이콘(이름은 버전마다 다름)은 중복이므로 제거
for f in "$dest"/*.desktop; do
    [ -f "$f" ] || continue
    case "$f" in *kiyu-install.desktop) continue ;; esac
    grep -q 'liveinst\|anaconda' "$f" 2>/dev/null && rm -f "$f"
done
exit 0
