#!/bin/sh
# 라이브 세션에서만: 바탕화면에 "설치" 아이콘을 놓습니다.
[ -d /run/initramfs/live ] || [ -d /run/live/medium ] || exit 0
command -v xdg-user-dir >/dev/null 2>&1 && dest="$(xdg-user-dir DESKTOP)" || dest="$HOME/Desktop"
mkdir -p "$dest"
src=/usr/share/applications/kiyu-install.desktop
if [ -f "$src" ] && [ ! -f "$dest/kiyu-install.desktop" ]; then
    cp "$src" "$dest/kiyu-install.desktop"; chmod +x "$dest/kiyu-install.desktop"
fi
# livesys 가 놓는 Fedora 기본 설치 아이콘(이름은 버전마다 다름)은 중복이므로 제거
for f in "$dest"/*.desktop; do
    [ -f "$f" ] || continue
    case "$f" in *kiyu-install.desktop) continue ;; esac
    grep -q 'liveinst\|anaconda' "$f" 2>/dev/null && rm -f "$f"
done
exit 0
