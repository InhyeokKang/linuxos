#!/bin/sh
# kiyu 설치 전용 X 세션. 설치 매체(라이브 ISO/USB)로 부팅하면 lightdm 이 데스크톱 대신 이 세션으로
# 자동 로그인한다(kiyu-live-installer.service 가 설정). 데스크톱 없이 창 관리자 + Anaconda 설치
# 프로그램만 띄운다 - 부팅하면 곧바로 "설치" 화면이 되게.
#  - Anaconda 가 뜨기까지 걸리는 시간 동안 "준비 중" 스플래시를 보여준다(빈 화면 방지).
#  - Anaconda 창이 뜨면 화면 전체로 키운다(데스크톱이 없으므로 작은 창이 덩그러니 놓이지 않게).
#  - 설치 프로그램이 닫히면 installer-finished 화면을 띄워 재부팅/전원끄기/다시 설치를 고르게 한다.
#    (예전에는 무조건 다시 띄워서, 설치를 끝내고 "설치 종료"를 눌러도 설치 화면으로 되돌아갔다.
#     Anaconda 는 라이브 설치에서 버튼을 "재부팅"이 아니라 "설치 종료"로만 주고 그냥 종료한다.)
#  - 설치된 시스템에서 실수로 이 세션을 고르면 평소 kiyu 데스크톱 세션으로 넘긴다.
[ -d /run/initramfs/live ] || exec /usr/bin/startkiyu

export XDG_CURRENT_DESKTOP=kiyu-installer
# 창 관리자. xfwm4 에는 --daemon 옵션이 없다(있는 줄 알고 쓰면 조용히 실패해 WM 없이 돌아간다).
# 백그라운드로 띄우고, 합성(compositor)은 설치 화면에 불필요하므로 끈다.
xfwm4 --compositor=off >/dev/null 2>&1 &
command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#f7f3ec' 2>/dev/null   # kiyu 종이색 배경
command -v xset >/dev/null 2>&1 && { xset s off; xset -dpms; } 2>/dev/null     # 설치 중 화면 꺼짐 방지

SPLASH=""

# Anaconda 창을 기다렸다가: 스플래시를 닫고, 창을 화면 전체로 키운다. 최대 3분.
watch_window() {
    i=0
    while [ $i -lt 360 ]; do
        w=$(xdotool search --onlyvisible --class '[Aa]naconda' 2>/dev/null | head -1)
        if [ -n "$w" ]; then
            [ -n "$SPLASH" ] && kill "$SPLASH" 2>/dev/null
            # 창 관리자가 최대화를 지원하면 그걸 쓰고, 아니면 화면 크기로 직접 맞춘다
            xdotool windowstate --add MAXIMIZED_VERT --add MAXIMIZED_HORZ "$w" 2>/dev/null \
                || { xdotool windowmove "$w" 0 0 2>/dev/null; xdotool windowsize "$w" 100% 100% 2>/dev/null; }
            xdotool windowactivate "$w" 2>/dev/null
            return 0
        fi
        i=$((i + 1)); sleep 0.5
    done
    [ -n "$SPLASH" ] && kill "$SPLASH" 2>/dev/null
}

while :; do
    # 이미 설치 프로그램이 돌고 있으면 새로 띄우지 않는다("Installer already running" 방지)
    if [ -e /run/anaconda/liveinst.lock ] && pgrep -f '[a]naconda' >/dev/null 2>&1; then
        sleep 5; continue
    fi

    if [ -x /usr/lib/kiyu/installer-splash ]; then
        /usr/lib/kiyu/installer-splash & SPLASH=$!
    fi

    command -v xhost >/dev/null 2>&1 && xhost +si:localuser:root >/dev/null 2>&1
    started=$(date +%s)
    if command -v liveinst >/dev/null 2>&1; then
        # liveinst(Anaconda) 는 root 가 필요하다. 라이브 사용자는 암호 없는 sudo 를 가지므로
        # X 접속 정보(DISPLAY/XAUTHORITY)만 넘겨 root 로 실행한다.
        sudo env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" /usr/bin/liveinst &
    elif command -v anaconda >/dev/null 2>&1; then
        # liveinst 래퍼가 없어도 Anaconda 본체가 있으면 GTK 설치 화면을 직접 띄운다
        sudo env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" /usr/bin/anaconda --liveinst --graphical &
    else
        # 설치 프로그램이 없는 이미지 - 빈 화면 대신 준비 화면을 계속 띄워 둔다
        wait "$SPLASH" 2>/dev/null; sleep 30; continue
    fi
    INST=$!

    watch_window
    wait "$INST" 2>/dev/null
    [ -n "$SPLASH" ] && kill "$SPLASH" 2>/dev/null; SPLASH=""

    # 곧바로 끝났으면(락 충돌 등) 사용자에게 물어볼 것도 없이 다시 띄운다 - 무한 재시도만 막는다
    if [ $(( $(date +%s) - started )) -lt 10 ]; then sleep 8; continue; fi

    # 설치 프로그램이 닫혔다. 다음에 무엇을 할지 고르게 한다.
    #   10 재부팅  11 전원 끄기  12 설치 다시 하기
    if [ -x /usr/lib/kiyu/installer-finished ]; then
        /usr/lib/kiyu/installer-finished
        case $? in
            10) systemctl reboot   2>/dev/null || reboot;   exit 0 ;;
            11) systemctl poweroff 2>/dev/null || poweroff; exit 0 ;;
            *)  sleep 1 ;;
        esac
    elif grep -q 'The installation has finished' /tmp/anaconda.log 2>/dev/null; then
        # 선택 화면이 없더라도 설치가 끝났으면 설치 화면으로 되돌아가지 않는다
        systemctl reboot 2>/dev/null || reboot
        exit 0
    else
        sleep 2
    fi
done
