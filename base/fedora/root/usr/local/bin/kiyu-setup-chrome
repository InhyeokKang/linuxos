#!/bin/bash
# kiyu 웹 브라우저 설치 + 영상 하드웨어 가속(VA-API) 켜기
#  기본:   chromium-freeworld (RPM Fusion) — VA-API 와 코덱이 내장돼 4K 재생에 가장 잘 맞음
#  --chrome:  Google Chrome 공식 rpm (VA-API 는 리눅스에서 불안정할 수 있음)
#  하는 일: 브라우저 설치 + VA-API 드라이버 확인 + 메뉴 실행 시 VA-API 플래그가 붙는 .desktop 오버레이 생성
set -euo pipefail
[ "$(id -u)" -ne 0 ] || { echo "일반 사용자로 실행하세요 (sudo 는 필요할 때만 씁니다)." >&2; exit 1; }
rel=$(rpm -E %fedora)

want_chrome=0
[ "${1:-}" = "--chrome" ] && want_chrome=1

echo "== [1/4] 하드웨어 디코드 드라이버(VA-API) 확인"
if ! command -v vainfo >/dev/null 2>&1 || ! vainfo 2>/dev/null | grep -q VAProfile; then
    echo "   VA-API 드라이버가 없거나 프로파일이 안 잡힙니다. kiyu-setup-codecs 를 먼저 실행하세요."
    echo "   (지금 계속하면 브라우저는 깔리지만 4K 는 소프트웨어 디코드로 버벅일 수 있습니다.)"
fi

if [ "$want_chrome" = 1 ]; then
    echo "== [2/4] Google Chrome 설치"
    sudo tee /etc/yum.repos.d/google-chrome.repo >/dev/null <<'REPO'
[google-chrome]
name=google-chrome
baseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64
enabled=1
gpgcheck=1
gpgkey=https://dl.google.com/linux/linux_signing_key.pub
REPO
    sudo dnf install -y google-chrome-stable
    APP=google-chrome; DESK=google-chrome.desktop; BIN=/usr/bin/google-chrome-stable
else
    echo "== [2/4] chromium-freeworld 설치 (VA-API·코덱 내장)"
    rpm -q rpmfusion-free-release >/dev/null 2>&1 || sudo dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${rel}.noarch.rpm"
    sudo dnf install -y chromium-freeworld
    APP=chromium-freeworld; DESK=chromium-freeworld.desktop; BIN=/usr/bin/chromium-freeworld
fi

echo "== [3/4] VA-API 플래그로 실행되도록 메뉴 항목 오버레이"
# X11(XFCE)에서 Chromium 계열 하드웨어 비디오 디코드에 필요한 플래그
FLAGS="--enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL --ignore-gpu-blocklist"
src="/usr/share/applications/$DESK"
dst="$HOME/.local/share/applications/$DESK"
mkdir -p "$HOME/.local/share/applications"
if [ -f "$src" ]; then
    # 원본 .desktop 을 복사하고 Exec 줄의 실행 파일 뒤에 플래그를 끼워 넣는다
    sed -E "s#^(Exec=[^ ]+)#\\1 $FLAGS#" "$src" > "$dst"
else
    cat > "$dst" <<EOF
[Desktop Entry]
Type=Application
Name=$APP (kiyu·VA-API)
Exec=$BIN $FLAGS %U
Terminal=false
Categories=Network;WebBrowser;
EOF
fi
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

echo "== [4/4] 완료"
cat <<EOF

설치·설정 끝났습니다. 확인 방법:
  1) 메뉴에서 브라우저를 (다시) 실행 → 주소창에 chrome://gpu
     "Video Decode" 가 "Hardware accelerated" 여야 GPU 로 디코드됩니다.
  2) 4K 유튜브 재생 중 터미널에서:  kiyu-perf-check --watch
     GPU 디코드면 CPU 낮게 유지, 아니면 CPU 급등.
참고:
  - 4K 유튜브는 VP9/AV1 코덱입니다. 오래된 내장 GPU 는 4K VP9/AV1 하드웨어 디코드를
    지원하지 않을 수 있고, 그러면 1080p 가 현실적인 한계입니다(OS 문제가 아니라 GPU 한계).
  - AV1 이 안 되는 GPU 면 확장 프로그램으로 유튜브를 VP9/H.264 로 강제하면 도움이 됩니다.
EOF
