<?xml version="1.0" encoding="UTF-8"?>
<!-- 하단 작업표시줄 (윈도우 11 식): 전체 폭 한 줄, 가운데 [시작] [고정 앱 + 실행 중 창 (docklike)],
     오른쪽 [트레이] [빠른 설정] [시계] [알림] [바탕화면 보기]. 소리/전원은 빠른 설정(kiyu-control)에 통합 -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="false"/>
    <property name="panel-1" type="empty">
      <!-- 바닥 전체 폭 (p=8: 왼쪽 아래에서 시작, 길이 100%) -->
      <property name="position" type="string" value="p=8;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="false"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="46"/>
      <property name="icon-size" type="uint" value="24"/>
      <!-- 배경은 ~/.config/gtk-3.0/gtk.css 의 .xfce4-panel 이 그린다 (테마 색 따라 다크 모드 자동) -->
      <property name="background-style" type="uint" value="0"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="3"/>
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- 양쪽 확장 구분선 사이에 시작 버튼과 앱 아이콘을 두어 가운데 정렬 (윈도우 11 식) -->
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-1" type="string" value="whiskermenu"/>
    <!-- 고정 앱과 실행 중인 창을 한 버튼으로, 실행 중이면 아래에 점 (docklike) -->
    <property name="plugin-2" type="string" value="docklike"/>
    <property name="plugin-5" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-6" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="18"/>
      <property name="hide-new-items" type="bool" value="false"/>
    </property>
    <!-- 빠른 설정: Wi-Fi / 블루투스 / 다크 모드 / 소리 / 밝기 / 배터리 / 효과 -->
    <property name="plugin-7" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/kiyu-control.desktop"/>
      </property>
      <property name="disable-tooltips" type="bool" value="true"/>
      <property name="show-label" type="bool" value="false"/>
    </property>
    <property name="plugin-9" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="1"/>
      <property name="digital-time-format" type="string" value="%H:%M"/>
      <property name="digital-date-format" type="string" value="%Y-%m-%d"/>
      <property name="digital-time-font" type="string" value="Pretendard Semi-Bold 9"/>
      <property name="digital-date-font" type="string" value="Pretendard 7"/>
      <property name="tooltip-format" type="string" value="%A %x"/>
    </property>
    <property name="plugin-10" type="string" value="notification-plugin"/>
    <property name="plugin-11" type="string" value="showdesktop"/>
  </property>
</channel>
