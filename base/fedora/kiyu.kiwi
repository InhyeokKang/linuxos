<?xml version="1.0" encoding="utf-8"?>
<!--
  kiyu — Fedora 기반 라이브/설치 ISO 정의 (kiwi-ng).
  빌드: sudo ./scripts/build-fedora.sh   (Fedora 컨테이너 안에서 실행됨)
  버전/이름은 os.conf 를 따르며 scripts/build-fedora.sh 가 이 파일의 @@VAR@@ 를 치환해 임시 사본을 만듭니다.
-->
<image schemaversion="7.5" name="@@OS_ID@@-@@OS_VERSION@@-x86_64">
  <description type="system">
    <author>@@OS_NAME@@</author>
    <contact>@@OS_HOME_URL@@</contact>
    <specification>@@OS_NAME@@ @@OS_VERSION@@ live / install image (Fedora @@FEDORA_RELEASE@@, XFCE)</specification>
  </description>

  <preferences>
    <version>@@OS_VERSION@@</version>
    <packagemanager>dnf5</packagemanager>
    <locale>ko_KR</locale>
    <keytable>kr</keytable>
    <timezone>Asia/Seoul</timezone>
    <rpm-excludedocs>true</rpm-excludedocs>
    <type image="iso" flags="dmsquash" firmware="uefi" mediacheck="false"
          hybridpersistent="true" hybridpersistent_filesystem="ext4"
          volid="@@VOLID@@"
          kernelcmdline="quiet rd.live.image slab_nomerge init_on_alloc=1 randomize_kstack_offset=on page_alloc.shuffle=1">
      <bootloader name="grub2" timeout="8"/>
    </type>
  </preferences>

  <!-- 저장소: 릴리스 + 업데이트 (보안 패치 반영된 이미지) -->
  <repository type="rpm-md" alias="fedora" priority="1">
    <source path="@@FEDORA_MIRROR@@/releases/@@FEDORA_RELEASE@@/Everything/x86_64/os/"/>
  </repository>
  <repository type="rpm-md" alias="updates" priority="1">
    <source path="@@FEDORA_MIRROR@@/updates/@@FEDORA_RELEASE@@/Everything/x86_64/"/>
  </repository>

  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="basesystem"/>
    <package name="fedora-release"/>
    <package name="fedora-gpg-keys"/>
    <package name="glibc-langpack-ko"/>
    <package name="glibc-langpack-en"/>
  </packages>

  <packages type="image">
    <!-- 커널 / 부팅 / 라이브 -->
    <package name="kernel"/>
    <package name="kernel-modules"/>
    <package name="kernel-modules-extra"/>
    <package name="dracut-live"/>
    <package name="dracut-config-generic"/>
    <package name="grub2-efi-x64"/>
    <package name="grub2-efi-x64-cdboot"/>
    <package name="grub2-pc"/>
    <package name="grub2-pc-modules"/>
    <package name="grub2-tools"/>
    <package name="grub2-tools-extra"/>
    <package name="grubby"/>
    <package name="shim-x64"/>
    <package name="efibootmgr"/>
    <package name="syslinux"/>
    <package name="livesys-scripts"/>
    <package name="anaconda-live"/>
    <package name="anaconda-install-env-deps"/>

    <!-- 시스템 -->
    <package name="systemd"/>
    <package name="systemd-udev"/>
    <package name="systemd-resolved"/>
    <package name="chrony"/>
    <package name="polkit"/>
    <package name="sudo"/>
    <package name="passwd"/>
    <package name="dnf5"/>
    <package name="dnf5-plugins"/>
    <package name="dnf5-plugin-automatic"/>
    <package name="selinux-policy-targeted"/>
    <package name="firewalld"/>
    <package name="zram-generator-defaults"/>
    <package name="fwupd"/>
    <package name="NetworkManager"/>
    <package name="NetworkManager-wifi"/>
    <package name="NetworkManager-bluetooth"/>
    <package name="network-manager-applet"/>
    <package name="nm-connection-editor"/>
    <package name="wpa_supplicant"/>
    <package name="bluez"/>
    <package name="blueman"/>
    <package name="pipewire"/>
    <package name="wireplumber"/>
    <package name="pipewire-pulseaudio"/>
    <package name="pipewire-alsa"/>
    <package name="alsa-utils"/>
    <package name="pavucontrol"/>
    <package name="cups"/>
    <package name="cups-filters"/>
    <package name="system-config-printer"/>
    <package name="udisks2"/>
    <package name="gvfs"/>
    <package name="gvfs-mtp"/>
    <package name="gvfs-smb"/>
    <package name="gvfs-fuse"/>
    <package name="ntfs-3g"/>
    <package name="exfatprogs"/>
    <package name="dosfstools"/>
    <package name="e2fsprogs"/>
    <package name="btrfs-progs"/>
    <package name="xfsprogs"/>
    <package name="cryptsetup"/>
    <package name="xdg-utils"/>
    <package name="xdg-user-dirs"/>
    <package name="bash-completion"/>
    <package name="nano"/>
    <package name="less"/>
    <package name="curl"/>
    <package name="wget"/>
    <package name="unzip"/>
    <package name="zip"/>
    <package name="p7zip"/>
    <package name="p7zip-plugins"/>
    <package name="pciutils"/>
    <package name="usbutils"/>
    <package name="procps-ng"/>
    <package name="psmisc"/>

    <!-- 하드웨어 / 그래픽 -->
    <package name="linux-firmware"/>
    <package name="microcode_ctl"/>
    <package name="xorg-x11-server-Xorg"/>
    <package name="xorg-x11-drv-libinput"/>
    <package name="xorg-x11-drv-amdgpu"/>
    <package name="xorg-x11-drv-vesa"/>
    <package name="xorg-x11-drv-vmware"/>
    <package name="xorg-x11-xinit"/>
    <package name="xorg-x11-xauth"/>
    <package name="xrandr"/>
    <package name="xset"/>
    <package name="xprop"/>
    <package name="xrdb"/>
    <package name="mesa-dri-drivers"/>
    <package name="mesa-vulkan-drivers"/>
    <package name="mesa-va-drivers"/>
    <package name="vulkan-loader"/>

    <!-- XFCE (윈도우 배치) -->
    <package name="xfce4-session"/>
    <package name="xfce4-panel"/>
    <package name="xfce4-settings"/>
    <package name="xfwm4"/>
    <package name="xfdesktop"/>
    <package name="xfconf"/>
    <package name="xfce4-appfinder"/>
    <package name="xfce4-whiskermenu-plugin"/>
    <package name="xfce4-pulseaudio-plugin"/>
    <package name="xfce4-power-manager"/>
    <package name="xfce4-notifyd"/>
    <package name="xfce4-screenshooter"/>
    <package name="xfce4-taskmanager"/>
    <package name="xfce4-terminal"/>
    <package name="xfce4-clipman-plugin"/>
    <package name="xfce4-screensaver"/>
    <package name="Thunar"/>
    <package name="thunar-archive-plugin"/>
    <package name="thunar-volman"/>
    <package name="tumbler"/>
    <package name="mate-polkit"/>
    <package name="lightdm"/>
    <package name="lightdm-gtk"/>
    <package name="xcape"/>
    <package name="arc-theme"/>
    <package name="papirus-icon-theme"/>
    <package name="adwaita-icon-theme"/>
    <package name="gtk-murrine-engine"/>
    <package name="librsvg2"/>
    <package name="librsvg2-tools"/>

    <!-- 폰트 / 한국어 -->
    <package name="google-noto-sans-fonts"/>
    <package name="google-noto-sans-mono-fonts"/>
    <package name="google-noto-sans-cjk-fonts"/>
    <package name="google-noto-serif-cjk-fonts"/>
    <package name="google-noto-color-emoji-fonts"/>
    <package name="liberation-fonts"/>
    <package name="fcitx5"/>
    <package name="fcitx5-hangul"/>
    <package name="fcitx5-gtk"/>
    <package name="fcitx5-qt"/>
    <package name="fcitx5-configtool"/>
    <package name="imsettings"/>
    <package name="imsettings-fcitx5"/>

    <!-- 앱 설치 (Flatpak + 스토어) -->
    <package name="flatpak"/>
    <package name="xdg-desktop-portal"/>
    <package name="xdg-desktop-portal-gtk"/>
    <package name="gnome-software"/>

    <!-- 기본 앱 -->
    <package name="firefox"/>
    <package name="mousepad"/>
    <package name="ristretto"/>
    <package name="mpv"/>
    <package name="xarchiver"/>
    <package name="galculator"/>
    <package name="gparted"/>
    <package name="libreoffice-writer"/>
    <package name="libreoffice-calc"/>
    <package name="libreoffice-impress"/>
    <package name="libreoffice-gtk3"/>
    <package name="libreoffice-langpack-ko"/>

    <!-- kiyu 브라우저 프로토타입 런타임 (WebKitGTK) -->
    <package name="python3-gobject"/>
    <package name="webkit2gtk4.1"/>
  </packages>
</image>
